.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.env
outputs/
# dora run が dataflow の yml の横に作るログのディレクトリ
out/
# 実験の記録のうち大きいものと、手元のパスを含むもの。代表的な動画は experiments/NNN-slug/videos/ に置く
experiments/*/runs/*/*.mp4
experiments/*/runs/*/ground_truth.jsonl
experiments/*/runs/*/robot_state.jsonl
experiments/*/runs/*/dora.log
# 表から外した記録 (通信の不調で止まったものなど)。理由は実験の README に書く
experiments/*/excluded-runs/*/*.mp4
experiments/*/excluded-runs/*/ground_truth.jsonl
experiments/*/excluded-runs/*/robot_state.jsonl
experiments/*/excluded-runs/*/dora.log
experiments/*/.dataflow-init*.yml
# レポートの PDF のビルド出力 (report/build.sh)
report/build/
